{
  "expo": {
    "name": "LocalWorx",
    "slug": "localworx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localworx",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.localworx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LocalWorx uses the camera to scan check-in and reward codes.",
        "NSLocationWhenInUseUsageDescription": "LocalWorx checks your location only when you check in, to confirm you're at the shop."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.localworx.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LocalWorx uses the camera to scan check-in and reward codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalWorx checks your location only when you check in, to confirm you're at the shop."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}